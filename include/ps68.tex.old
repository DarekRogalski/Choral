\lat{Salvum me fac, Deus: * quóniam intravérunt aquæ usque ad ánimam meam.} \pol{\tlumacz{Wybaw mię, Boże, \red{*} bo weszły wody aż do duszy mojej.}}
\lat{Infíxus sum in limo profúndi: \red{*} et non est substántia.} \pol{\tlumacz{Ulgnąłem w błocie głębokim \red{*} i nie masz dna.}}
\lat{Veni in altitúdinem maris: \red{*} et tempéstas demérsit me.} \pol{\tlumacz{Przyszedłem na głębinę morską \red{*} i pogrążyła mię nawałność.}}
\lat{Laborávi clamans, raucæ factæ sunt fauces meæ: \red{*} defecérunt óculi mei, dum spero in Deum meum.} \pol{\tlumacz{Zmęczyłem się od wołania, ochrypło gardło moje, \red{*} ustały oczy moje, gdy wyczekuję Boga mego.}}
\lat{Multiplicáti sunt super capíllos cápitis mei, \red{*} qui odérunt me gratis.} \pol{\tlumacz{Rozmnożyli się nad włosy głowy mojej \red{*} nienawidzący mnie bez przyczyny.}}
\lat{Confortáti sunt qui persecúti sunt me inimíci mei injúste: \red{*} quæ non rápui, tunc exsolvébam.} \pol{\tlumacz{Wzmocnili się prześladujący mnie niesprawiedliwie, nieprzyjaciele moi, \red{*} czegom nie wydarł, wtedy oddawałem.}}
\lat{Deus, tu scis insipiéntiam meam: \red{*} et delícta mea a te non sunt abscóndita.} \pol{\tlumacz{Boże, Ty znasz głupotę moją \red{*} i występki moje nie są Tobie tajne.}}
\lat{Non erubéscant in me qui exspéctant te, Dómine, \red{*} Dómine virtútum.} \pol{\tlumacz{Niech nie będą zawstydzeni mną ci, którzy Cię oczekują, Panie, \red{*} Panie zastępów.}}
\lat{Non confundántur super me \red{*} qui quǽrunt te, Deus Israël.} \pol{\tlumacz{Niech nie będą zmieszani przeze mnie ci, \red{*} którzy Cię szukają, Boże Izraela.}}
\lat{Quóniam propter te sustínui oppróbrium: \red{*} opéruit confúsio fáciem meam.} \pol{\tlumacz{Bo dla Ciebie znosiłem urąganie, \red{*} zelżywość okryła oblicze moje.}}
\lat{Extráneus factus sum frátribus meis, \red{*} et peregrínus fíliis matris meæ.} \pol{\tlumacz{Stałem się obcy dla braci moich \red{*} i cudzoziemcem dla synów matki mojej.}}
\lat{Quóniam zelus domus tuæ comédit me: \red{*} et oppróbria exprobrántium tibi cecidérunt super me.} \pol{\tlumacz{Bo mię zawistna miłość domu Twego gryzła \red{*} i urągania urągających Tobie spadły na mnie.}}
\lat{Et opérui in jejúnio ánimam meam: \red{*} et factum est in oppróbrium mihi.} \pol{\tlumacz{I okryłem postem duszę moją \red{*} i stało mi się to na urąganie.}}
\lat{Et pósui vestiméntum meum cilícium: \red{*} et factus sum illis in parábolam.} \pol{\tlumacz{I oblokłem zamiast szaty włosiennicę \red{*} i stałem się im przypowieścią.}}
\lat{Advérsum me loquebántur, qui sedébant in porta: \red{*} et in me psallébant qui bibébant vinum.} \pol{\tlumacz{Mówili przeciwko mnie, którzy siedzieli w bramie, \red{*} i śpiewali przeciw mnie, którzy pili wino.}}
\lat{Ego vero oratiónem meam ad te, Dómine: \red{*} tempus benepláciti, Deus.} \pol{\tlumacz{Ale ja modlitwę moją do Ciebie zanoszę Panie, \red{*} czas upodobania, Boże.}}
\lat{In multitúdine misericórdiæ tuæ exáudi me, \red{*} in veritáte salútis tuæ:} \pol{\tlumacz{W wielkości miłosierdzia Twego wysłuchaj mnie \red{*} w prawdzie zbawienia Twego:}}
\lat{Éripe me de luto, ut non infígar: \red{*} líbera me ab iis, qui odérunt me, et de profúndis aquárum.} \pol{\tlumacz{Wyrwij mię z błota, abym nie ulgnął, \red{*} wybaw mię od tych, którzy mię nienawidzą, i z głębiny wód.}}
\lat{Non me demérgat tempéstas aquæ, neque absórbeat me profúndum: \red{*} neque úrgeat super me púteus os suum.} \pol{\tlumacz{Niech mnie nie zatapia nawałność wody i nie pożera mnie głębina, \red{*} ani niech nie zawiera nade mną studnia otworu swego.}}
\lat{Exáudi me, Dómine, quóniam benígna est misericórdia tua: \red{*} secúndum multitúdinem miseratiónum tuárum réspice in me.} \pol{\tlumacz{Wysłuchaj mię, Panie, bo łaskawe jest miłosierdzie Twoje: \red{*} według mnóstwa litości Twoich wejrzyj na mnie.}}
\lat{Et ne avértas fáciem tuam a púero tuo: \red{*} quóniam tríbulor, velóciter exáudi me.} \pol{\tlumacz{I nie odwracaj oblicza Twego od sługi swego, \red{*} ponieważ jestem w utrapieniu, prędko wysłuchaj mię.}}
\lat{Inténde ánimæ meæ, et líbera eam: \red{*} propter inimícos meos éripe me.} \pol{\tlumacz{Przybliż się ku duszy mojej i wybaw ją, \red{*} na przekór wrogom moim wyrwij mię.}}
\lat{Tu scis impropérium meum, et confusiónem meam, \red{*} et reveréntiam meam.} \pol{\tlumacz{Ty znasz hańbę moją i wstyd mój \red{*} i poniżenie moje.}}
\lat{In conspéctu tuo sunt omnes qui tríbulant me: \red{*} impropérium exspectávit cor meum, et misériam.} \pol{\tlumacz{Przed oczyma Twymi są wszyscy, którzy mię trapią: \red{*} urągania i nędzy czekało serce moje.}}
\lat{Et sustínui qui simul contristarétur, et non fuit: \red{*} et qui consolarétur, et non invéni.} \pol{\tlumacz{I czekałem, kto by się razem smucił, a nie było, \red{*} i kto by pocieszył, a nie znalazłem.}}
\lat{Et dedérunt in escam meam fel: \red{*} et in siti mea potavérunt me acéto.} \pol{\tlumacz{I dali mi żółć na pokarm, \red{*} a w pragnieniu moim napoili mię octem.}}
\lat{Fiat mensa eórum coram ipsis in láqueum, \red{*} et in retributiónes, et in scándalum.} \pol{\tlumacz{Niechaj będzie stół ich przed nimi sidłem \red{*} i ku zapłacie, i na upadek.}}
\lat{Obscuréntur óculi eórum ne vídeant: \red{*} et dorsum eórum semper incúrva.} \pol{\tlumacz{Niech się zaćmią ich oczy, aby nie widzieli: \red{*} a grzbiet ich zawsze nachylaj.}}
\lat{Effúnde super eos iram tuam: \red{*} et furor iræ tuæ comprehéndat eos.} \pol{\tlumacz{Wylej na nich gniew Twój \red{*} i zapalczywość gniewu Twego niech ich ogarnie.}}
\lat{Fiat habitátio eórum desérta: \red{*} et in tabernáculis eórum non sit qui inhábitet.} \pol{\tlumacz{Mieszkanie ich niech się stanie puste, \red{*} a w przybytkach ich niechaj nikt nie mieszka.}}
\lat{Quóniam quem tu percussísti, persecúti sunt: \red{*} et super dolórem vúlnerum meórum addidérunt.} \pol{\tlumacz{Bo któregoś Ty zranił, prześladowali, \red{*} a do boleści ran moich dodawali.}}
\lat{Appóne iniquitátem super iniquitátem eórum: \red{*} et non intrent in justítiam tuam.} \pol{\tlumacz{Przydaj nieprawość do nieprawości ich, \red{*} a niech nie wchodzą do sprawiedliwości Twojej.}}
\lat{Deleántur de libro vivéntium: \red{*} et cum justis non scribántur.} \pol{\tlumacz{Niech będą wymazani z księgi żyjących \red{*} i niech ze sprawiedliwymi nie będą wpisani.}}
\lat{Ego sum pauper et dolens: \red{*} salus tua, Deus, suscépit me.} \pol{\tlumacz{Jam jest ubogi i zbolały, \red{*} zbawienie Twoje, Boże, wspomogło mię.}}
\lat{Laudábo nomen Dei cum cántico: \red{*} et magnificábo eum in laude:} \pol{\tlumacz{Będę chwalił imię Boże pieśnią, \red{*} i wielbić Go będę chwalbą:}}
\lat{Et placébit Deo super vítulum novéllum: \red{*} córnua producéntem et úngulas.} \pol{\tlumacz{A przyjemniejsze to będzie Panu niźli młody cielec, \red{*} któremu rogi i kopyta podrastają.}}
\lat{Vídeant páuperes et læténtur: \red{*} quǽrite Deum, et vivet ánima vestra.} \pol{\tlumacz{Niech widzą ubodzy i niech się weselą: \red{*} szukajcie Boga, a będzie żyła dusza wasza.}}
\lat{Quóniam exaudívit páuperes Dóminus: \red{*} et vinctos suos non despéxit.} \pol{\tlumacz{Albowiem Pan wysłuchał ubogich, \red{*} a więźniami swymi nie wzgardził.}}
\lat{Laudent illum cæli et terra, \red{*} mare et ómnia reptília in eis.} \pol{\tlumacz{Niechaj Go chwalą niebiosa i ziemia, \red{*} morze i wszystek płaz na nich.}}
\lat{Quóniam Deus salvam fáciet Sion: \red{*} et ædificabúntur civitátes Juda.} \pol{\tlumacz{Albowiem Bóg zbawi Syjon \red{*} i będą zbudowane miasta Judy.}}
\lat{Et inhabitábunt ibi, \red{*} et hereditáte acquírent eam.} \pol{\tlumacz{I będą tam mieszkać \red{*} i dostaną go dziedzictwem.}}
\lat{Et semen servórum ejus possidébit eam: \red{*} et qui díligunt nomen ejus, habitábunt in ea.} \pol{\tlumacz{I potomstwo sług Jego posiądzie go, \red{*} a którzy miłują imię Jego, będą na nim mieszkać.}}
